{
  "workspaceRoot": "D:/path/to/test-project",
  "plansDir": ".patchwarden/plans",
  "tasksDir": ".patchwarden/tasks",
  "toolProfile": "full",
  "agents": {
    "codex": {
      "command": "codex",
      "args": ["exec", "--cd", "{repo}", "{prompt}"],
      "adapter": "codex",
      "default_model": null,
      "available_models": [],
      "allow_unlisted_model_override": true,
      "envAllowlist": []
    },
    "opencode": {
      "command": "opencode",
      "args": ["run", "{prompt}"],
      "adapter": "opencode",
      "provider": "agnes",
      "default_model": "agnes/agnes-2.0-flash",
      "available_models": ["agnes/agnes-2.0-flash"],
      "allow_unlisted_model_override": true,
      "envAllowlist": []
    },
    "claude": {
      "command": "claude",
      "args": ["-p", "{prompt}"],
      "adapter": "claude",
      "default_model": null,
      "available_models": [],
      "allow_unlisted_model_override": true,
      "settings_policy": "inherit",
      "envAllowlist": []
    }
  },
  "repoAgentDefaults": {
    "my-project": {
      "opencode": "agnes/agnes-2.0-flash"
    }
  },
  "allowedTestCommands": [
    "npm test",
    "npm run test",
    "npm run lint",
    "npm run format:check",
    "npm run build",
    "npm run dist",
    "npm run doctor",
    "pnpm test",
    "pnpm run test",
    "pnpm run lint",
    "pnpm run format:check",
    "pnpm run build",
    "pnpm run dist",
    "pnpm run doctor",
    "yarn test",
    "pytest",
    "cargo test",
    "go test ./..."
  ],
  "repoAllowedTestCommands": {
    "desktop-app": [
      "npm run release:check"
    ]
  },
  "maxReadFileBytes": 200000,
  "defaultTaskTimeoutSeconds": 900,
  "maxTaskTimeoutSeconds": 3600,
  "watcherStaleSeconds": 30,
  "taskArchiveRetentionDays": 30,
  "taskArchiveCleanupIntervalHours": 24,
  "taskArchiveCleanupMaxBatch": 100
}
